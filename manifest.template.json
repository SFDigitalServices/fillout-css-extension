{
  "manifest_version": 3,
  "name": "SF.gov Fillout CSS",
  "description": "Swap the custom CSS of SF.gov Fillout forms with a bundled, local, or remote stylesheet.",
  "minimum_chrome_version": "111",
  "permissions": ["storage"],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://digital.forms.sf.gov/*",
        "https://forms.fillout.com/*"
      ],
      "js": ["content-main.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://digital.forms.sf.gov/*",
        "https://forms.fillout.com/*"
      ],
      "js": ["content-isolated.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
